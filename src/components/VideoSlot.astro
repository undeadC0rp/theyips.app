---
// A self-hosted walkthrough video (MP4 in our own storage, no third-party
// player). Renders nothing, heading included, until `src` is supplied, so a
// guide page reads fine as text before its video exists.
//
// Phone recordings are portrait, so the player is a narrow column rather than
// a 16:9 frame.
interface Props {
  src?: string;
  poster?: string;
  captions?: string;
  title: string;
  heading?: string;
  blurb?: string;
}

const { src, poster, captions, title, heading = 'Watch it first', blurb } = Astro.props;
---

{
  src && (
    <section class="section">
      <h2>{heading}</h2>
      {blurb && <p>{blurb}</p>}
      <figure class="video">
        <video controls preload="metadata" playsinline poster={poster} aria-label={title}>
          <source src={src} type="video/mp4" />
          {captions && (
            <track kind="captions" src={captions} srclang="en" label="English" default />
          )}
          Your browser can't play this video. <a href={src}>Download it instead.</a>
        </video>
      </figure>
    </section>
  )
}

<style>
  .video {
    margin: 24px 0 8px;
    max-width: 320px;
  }

  .video video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }
</style>
