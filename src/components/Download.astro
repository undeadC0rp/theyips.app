---
const PLAY_URL = 'https://play.google.com/store/apps/details?id=app.theyips';
---

<section class="download" id="download">
  <div class="container inner">
    <div class="copy">
      <h2>Start logging<br /><em>real rounds.</em></h2>
      <p>Free to start. Your data comes with you.</p>
    </div>
    <div class="actions">
      <a href={PLAY_URL} class="btn-primary" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12l5 5L20 7"/>
        </svg>
        Get it on Google Play
      </a>
      <p class="note">Android only · feedback welcome</p>
    </div>
  </div>
</section>

<style>
  .download {
    padding: 80px 0;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  h2 em { color: var(--green); font-style: normal; }

  .copy p { font-size: 15px; color: var(--muted); }

  .actions { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--bg);
    background: var(--green);
    padding: 14px 28px;
    border-radius: 8px;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.88; }

  .note { font-size: 12px; color: var(--muted2); }
</style>
