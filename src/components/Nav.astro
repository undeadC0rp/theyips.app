---
const PLAY_URL = 'https://play.google.com/store/apps/details?id=app.theyips';
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span class="logo-the">the</span>
      <span class="logo-yips">Yips</span>
    </a>
    <div class="nav-links">
      <a href="/#features" class="nav-link">Features</a>
      <a href="/#screenshots" class="nav-link">Screenshots</a>
      <a href="/#faq" class="nav-link">FAQ</a>
      <a href="/guide" class="nav-link">Guide</a>
      <a href="/stats" class="nav-link">Stats</a>
      <a href="/cli" class="nav-link">CLI</a>
    </div>
    <a href={PLAY_URL} class="nav-dl" target="_blank" rel="noopener">
      Get the app
    </a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(8px);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
    margin-right: 20px;
  }

  /* Phones: logo and install button on top, the links in a swipeable row. */
  @media (max-width: 720px) {
    .nav-inner {
      flex-wrap: wrap;
      row-gap: 10px;
      padding-top: 12px;
      padding-bottom: 10px;
    }

    .nav-links {
      order: 3;
      width: 100%;
      margin: 0;
      gap: 18px;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar { display: none; }

    .nav-dl { margin-left: auto; }
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav-link:hover { color: var(--text); }

  .nav-logo {
    display: flex;
    align-items: baseline;
    gap: 3px;
    font-weight: 700;
    font-size: 18px;
  }

  .logo-the { color: var(--muted); font-weight: 400; font-size: 14px; }
  .logo-yips { color: var(--text); }

  .nav-dl {
    font-size: 13px;
    font-weight: 600;
    color: var(--bg);
    background: var(--green);
    padding: 8px 16px;
    border-radius: 6px;
    transition: opacity 0.15s;
  }

  .nav-dl:hover { opacity: 0.88; }
</style>
